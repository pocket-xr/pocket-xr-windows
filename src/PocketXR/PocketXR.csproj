<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>PocketXR</RootNamespace>
    <AssemblyName>PocketXR</AssemblyName>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\PocketXR.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <Product>Pocket XR</Product>
    <AssemblyTitle>Pocket XR</AssemblyTitle>
    <Company>Pocket XR</Company>
    <Copyright>GPL-3.0</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- A release is one .exe: no separate debugging files beside it. -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.6.2" />
    <PackageReference Include="Vortice.DXGI" Version="3.6.2" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.6.2" />
    <!-- Hand tracking: runs MediaPipe's hand models (Hands/Models, Apache 2.0) on the CPU. MIT licence. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Hands\Models\hand_detector.onnx" LogicalName="PocketXR.Hands.hand_detector.onnx" />
    <EmbeddedResource Include="Hands\Models\hand_landmarks_detector.onnx" LogicalName="PocketXR.Hands.hand_landmarks_detector.onnx" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PocketXR.Core\PocketXR.Core.csproj" />
  </ItemGroup>

</Project>
